---
// Kevin and Shelly — site layout (SMP 100 Club pattern).
//   - <slot name="head"> for per-page hero preload (Trait 2)
//   - Self-hosted R2 fonts, 2 preloads (Trait 4)
//   - Deferred third-party JS pattern at the bottom (Trait 5)
//   - public/_headers ships CSP + Early Hints
import HundredClubBadge from '../components/HundredClubBadge.astro';
import MailtoLink from '../components/MailtoLink.astro';
import { urlFor } from '../lib/sanity';
import { getSettings, NAV, SITE_NAME } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Home page: header floats over the hero photo on a semi-transparent charcoal bar (white logo). */
  overlayHeader?: boolean;
}
const settings = await getSettings();
const {
  title,
  description = settings?.seoDescription ?? '',
  ogImage = settings?.ogImage ? urlFor(settings.ogImage).width(1200).height(630).format('jpg').quality(80).url() : undefined,
  noindex = false,
  overlayHeader = false,
} = Astro.props;
const currentYear = new Date().getFullYear();
const siteOrigin = (Astro.site && Astro.site.toString().replace(/\/$/, '')) || '';
const canonicalURL = siteOrigin ? new URL(Astro.url.pathname, siteOrigin).href : Astro.url.pathname;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const socials: { label: string; url: string }[] = settings?.socials ?? [];
// Black logo on light bands, white logo on dark bands and over photos (Kevin 2026-10-14).
// Width attribute derived from the Sanity asset id (image-<hash>-<W>x<H>-png) so a swapped logo never causes layout shift.
const ratio = (img: any) => {
  const m = /-(\d+)x(\d+)-/.exec(img?.asset?._ref ?? '');
  return m ? Number(m[1]) / Number(m[2]) : 3.5;
};
const logo = (img: any, h: number) => (img ? { src: urlFor(img).height(h * 3).format('png').url(), w: Math.round(h * ratio(img)), h } : null);
const headerLogo = overlayHeader ? logo(settings?.logoOnDark, 45) : logo(settings?.logo, 45);
const footerLogo = logo(settings?.logoOnDark, 40);
// Social icon paths (same set as spiritmediapublishing.com footer), keyed by the Sanity social label.
const ICONS: Record<string, string> = {
  Facebook: '<path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12Z"/>',
  Instagram: '<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069ZM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0Zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881Z"/>',
  YouTube: '<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z"/>',
  LinkedIn: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003Z"/>',
  X: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="preload" as="font" type="font/woff2" href="https://assets.spiritmediapublishing.com/fonts/karla/karla-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="https://assets.spiritmediapublishing.com/fonts/dm-serif-display/dm-serif-display-400.woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE_NAME,
      url: siteOrigin,
      publisher: { '@type': 'Organization', name: 'Spirit Media Publishing', url: 'https://spiritmediapublishing.com' },
    })}></script>

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class:list={["site-header", { "is-overlay": overlayHeader }]} id="site-header">
      <div class="container-site header-inner">
        <a href="/" class="wordmark" aria-label={`${SITE_NAME} home`}>
          {headerLogo
            ? <img class="logo-img" src={headerLogo.src} alt="Kevin and Shelly" width={headerLogo.w} height={headerLogo.h} />
            : SITE_NAME}
        </a>
        <nav class="nav-desktop" aria-label="Main">
          {NAV.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <details class="nav-mobile">
          <summary aria-label="Menu"><span></span><span></span><span></span></summary>
          <nav aria-label="Main mobile">
            {NAV.map((item) => (
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
            ))}
          </nav>
        </details>
      </div>
    </header>

    <slot />

    <!-- Compact footer (Kevin 2026-10-15): one row — logo · nav · email · social icons — then the legal line.
         The footer is the contact point; there is no contact page. -->
    <footer class="site-footer band-dark">
      <div class="container-site footer-row">
        <a href="/" class="wordmark" aria-label={`${SITE_NAME} home`}>
          {footerLogo ? <img class="logo-img logo-footer" src={footerLogo.src} alt="Kevin and Shelly" width={footerLogo.w} height={footerLogo.h} loading="lazy" /> : SITE_NAME}
        </a>
        <nav class="footer-nav" aria-label="Footer">
          {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="footer-contact">
          {settings?.kevinEmail && <MailtoLink email={settings.kevinEmail} class="footer-mail">Email Kevin</MailtoLink>}
          {settings?.shellyEmail && <MailtoLink email={settings.shellyEmail} class="footer-mail">Email Shelly</MailtoLink>}
        </div>
        {socials.length > 0 && (
          <ul class="footer-socials">
            {socials.map((s) => (
              <li><a href={s.url} rel="noopener" target="_blank" aria-label={s.label} title={s.label}>
                {ICONS[s.label]
                  ? <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" set:html={ICONS[s.label]} />
                  : s.label}
              </a></li>
            ))}
          </ul>
        )}
      </div>
      <div class="container-site footer-legal">
        <p>
          &copy; {currentYear} {SITE_NAME}. All rights reserved. &bull; Powered by <a href="https://spiritmediapublishing.com">Spirit Media</a>
          <HundredClubBadge />
        </p>
      </div>
    </footer>

    <style>
      .skip-link { position: absolute; left: -9999px; top: 8px; background: var(--color-ink); color: var(--color-stone); padding: 8px 14px; z-index: 50; }
      .skip-link:focus { left: 8px; }
      .site-header { background: var(--color-stone); border-bottom: 1px solid var(--color-line); position: relative; z-index: 20; }
      .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; }
      .wordmark { font-family: var(--font-display); font-size: 24px; text-decoration: none; color: inherit; white-space: nowrap; display: inline-flex; align-items: center; }
      .logo-img { height: 45px; width: auto; }
      @media (max-width: 560px) { .logo-img { height: 38px; } }
      .nav-desktop { display: flex; gap: 26px; font-size: 15.5px; font-weight: 500; }
      .nav-desktop a { text-decoration: none; color: var(--color-soft); padding-block: 6px; border-bottom: 2px solid transparent; }
      .nav-desktop a:hover, .nav-desktop a[aria-current='page'] { color: var(--color-ink); border-bottom-color: var(--color-denim); }
      .nav-mobile { display: none; position: relative; }
      .nav-mobile summary { list-style: none; cursor: pointer; display: grid; gap: 5px; padding: 10px; }
      .nav-mobile summary::-webkit-details-marker { display: none; }
      .nav-mobile summary span { display: block; width: 24px; height: 2px; background: var(--color-ink); }
      .nav-mobile nav { position: absolute; right: 0; top: calc(100% + 8px); background: var(--color-stone); border: 1px solid var(--color-line); border-radius: var(--radius); padding: 8px; display: grid; min-width: 200px; box-shadow: 0 12px 30px -12px rgba(0,0,0,0.25); }
      .nav-mobile nav a { text-decoration: none; padding: 12px 14px; font-weight: 500; }
      .nav-mobile nav a[aria-current='page'] { color: var(--color-denim); }
      @media (max-width: 820px) { .nav-desktop { display: none; } .nav-mobile { display: block; } }

      /* Home: header floats over the hero (like fathersheartbible.com/print), semi-transparent charcoal */
      .site-header.is-overlay { position: fixed; inset: 0 0 auto 0; background: var(--color-charcoal-glass); border-bottom-color: transparent; -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); transition: background-color 0.25s ease; padding-top: env(safe-area-inset-top, 0px); }
      .site-header.is-overlay.is-solid { background: var(--color-charcoal-solid); }
      .is-overlay .wordmark { color: var(--color-on-dark); }
      .is-overlay .nav-desktop a { color: var(--color-on-dark); }
      .is-overlay .nav-desktop a:hover, .is-overlay .nav-desktop a[aria-current='page'] { color: var(--color-on-dark); border-bottom-color: var(--color-gold); }
      .is-overlay .nav-mobile summary span { background: var(--color-on-dark); }
      .is-overlay .nav-mobile nav { background: var(--color-charcoal); border-color: var(--color-line-dark); }
      .is-overlay .nav-mobile nav a { color: var(--color-on-dark); }

      .site-footer { padding-block: 36px 22px; }
      .footer-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 32px; }
      .logo-footer { height: 40px; }
      .footer-nav, .footer-contact { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 15px; }
      .footer-nav a, .footer-socials a, .footer-mail { color: var(--color-on-dark); text-decoration: none; }
      .footer-nav a:hover, .footer-socials a:hover, .footer-mail:hover { color: var(--color-gold); }
      .footer-socials { list-style: none; margin: 0; padding: 0; display: flex; gap: 6px; }
      .footer-socials a { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; color: var(--color-on-dark-soft); }
      .footer-legal { margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--color-line-dark); font-size: 13px; color: var(--color-on-dark-soft); }
      .footer-legal a { color: var(--color-on-dark); }
      @media (max-width: 720px) { .footer-row { flex-direction: column; align-items: flex-start; } }
    </style>

    {overlayHeader && (
      <script is:inline>
        (function () {
          var h = document.getElementById('site-header');
          var hero = document.querySelector('[data-hero]');
          if (!h || !hero || !('IntersectionObserver' in window)) return;
          new IntersectionObserver(function (e) { h.classList.toggle('is-solid', !e[0].isIntersecting); }, { rootMargin: '-80px 0px 0px 0px' }).observe(hero);
        })();
      </script>
    )}

    <!-- Deferred third-party JS (Trait 5) — fill GA4 ID when the property is created.
    <script is:inline>
      const loadAnalytics = () => {
        if (window._smpAnalyticsLoaded) return;
        window._smpAnalyticsLoaded = true;
        const s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=GTM_ID';
        s.async = true;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){ window.dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'GTM_ID');
      };
      ['scroll', 'click', 'touchstart', 'keydown', 'mousemove'].forEach((e) =>
        window.addEventListener(e, loadAnalytics, { once: true, passive: true })
      );
      setTimeout(loadAnalytics, 8000);
    </script>
    -->
  </body>
</html>
