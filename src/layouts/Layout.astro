---
// Kevin & Shelly — site layout (SMP 100 Club pattern).
//   - <slot name="head"> for per-page hero preload (Trait 2)
//   - Self-hosted R2 fonts, 2 preloads (Trait 4)
//   - Deferred third-party JS pattern at the bottom (Trait 5)
//   - public/_headers ships CSP + Early Hints
import HundredClubBadge from '../components/HundredClubBadge.astro';
import MailtoLink from '../components/MailtoLink.astro';
import { urlFor } from '../lib/sanity';
import { getSettings, NAV, SITE_NAME } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Home page: header floats over the hero photo on a semi-transparent charcoal bar (white logo). */
  overlayHeader?: boolean;
}
const settings = await getSettings();
const {
  title,
  description = settings?.seoDescription ?? '',
  ogImage = settings?.ogImage ? urlFor(settings.ogImage).width(1200).height(630).format('jpg').quality(80).url() : undefined,
  noindex = false,
  overlayHeader = false,
} = Astro.props;
const currentYear = new Date().getFullYear();
const siteOrigin = (Astro.site && Astro.site.toString().replace(/\/$/, '')) || '';
const canonicalURL = siteOrigin ? new URL(Astro.url.pathname, siteOrigin).href : Astro.url.pathname;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const socials: { label: string; url: string }[] = settings?.socials ?? [];
// Black logo on light bands, white logo on dark bands and over photos (Kevin 2026-10-14).
const logoLight = settings?.logo ? urlFor(settings.logo).height(132).format('png').url() : null;
const logoDark = settings?.logoOnDark ? urlFor(settings.logoOnDark).height(132).format('png').url() : null;
const headerLogo = overlayHeader ? logoDark : logoLight;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="preload" as="font" type="font/woff2" href="https://assets.spiritmediapublishing.com/fonts/karla/karla-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="https://assets.spiritmediapublishing.com/fonts/dm-serif-display/dm-serif-display-400.woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE_NAME,
      url: siteOrigin,
      publisher: { '@type': 'Organization', name: 'Spirit Media Publishing', url: 'https://spiritmediapublishing.com' },
    })}></script>

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class:list={["site-header", { "is-overlay": overlayHeader }]} id="site-header">
      <div class="container-site header-inner">
        <a href="/" class="wordmark" aria-label={`${SITE_NAME} home`}>
          {headerLogo
            ? <img class="logo-img" src={headerLogo} alt={SITE_NAME} width="139" height="45" />
            : SITE_NAME}
        </a>
        <nav class="nav-desktop" aria-label="Main">
          {NAV.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <details class="nav-mobile">
          <summary aria-label="Menu"><span></span><span></span><span></span></summary>
          <nav aria-label="Main mobile">
            {NAV.map((item) => (
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
            ))}
          </nav>
        </details>
      </div>
    </header>

    <slot />

    <footer class="site-footer band-dark">
      <div class="container-site footer-grid">
        <div class="footer-brand">
          <a href="/" class="wordmark" aria-label={`${SITE_NAME} home`}>
            {logoDark ? <img class="logo-img logo-footer" src={logoDark} alt={SITE_NAME} width="170" height="54" loading="lazy" /> : SITE_NAME}
          </a>
          {settings?.tagline && <p class="text-soft">{settings.tagline}</p>}
          {settings?.location && <p class="text-soft">{settings.location}</p>}
        </div>
        <nav class="footer-nav" aria-label="Footer">
          {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="footer-contact">
          {settings?.kevinEmail && <MailtoLink email={settings.kevinEmail} class="footer-mail">Email Kevin</MailtoLink>}
          {settings?.shellyEmail && <MailtoLink email={settings.shellyEmail} class="footer-mail">Email Shelly</MailtoLink>}
          {socials.length > 0 && (
            <ul class="footer-socials">
              {socials.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}
            </ul>
          )}
        </div>
      </div>
      <div class="container-site footer-legal">
        <p>
          &copy; {currentYear} {SITE_NAME}. All rights reserved. &bull; Powered by <a href="https://spiritmediapublishing.com">Spirit Media</a>
          <HundredClubBadge />
        </p>
      </div>
    </footer>

    <style>
      .skip-link { position: absolute; left: -9999px; top: 8px; background: var(--color-ink); color: var(--color-stone); padding: 8px 14px; z-index: 50; }
      .skip-link:focus { left: 8px; }
      .site-header { background: var(--color-stone); border-bottom: 1px solid var(--color-line); position: relative; z-index: 20; }
      .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 68px; }
      .wordmark { font-family: var(--font-display); font-size: 24px; text-decoration: none; color: inherit; white-space: nowrap; display: inline-flex; align-items: center; }
      .logo-img { height: 45px; width: auto; }
      .logo-footer { height: 54px; }
      @media (max-width: 560px) { .logo-img { height: 38px; } }
      .nav-desktop { display: flex; gap: 26px; font-size: 15.5px; font-weight: 500; }
      .nav-desktop a { text-decoration: none; color: var(--color-soft); padding-block: 6px; border-bottom: 2px solid transparent; }
      .nav-desktop a:hover, .nav-desktop a[aria-current='page'] { color: var(--color-ink); border-bottom-color: var(--color-denim); }
      .nav-mobile { display: none; position: relative; }
      .nav-mobile summary { list-style: none; cursor: pointer; display: grid; gap: 5px; padding: 10px; }
      .nav-mobile summary::-webkit-details-marker { display: none; }
      .nav-mobile summary span { display: block; width: 24px; height: 2px; background: var(--color-ink); }
      .nav-mobile nav { position: absolute; right: 0; top: calc(100% + 8px); background: var(--color-stone); border: 1px solid var(--color-line); border-radius: var(--radius); padding: 8px; display: grid; min-width: 200px; box-shadow: 0 12px 30px -12px rgba(0,0,0,0.25); }
      .nav-mobile nav a { text-decoration: none; padding: 12px 14px; font-weight: 500; }
      .nav-mobile nav a[aria-current='page'] { color: var(--color-denim); }
      @media (max-width: 820px) { .nav-desktop { display: none; } .nav-mobile { display: block; } }

      /* Home: header floats over the hero (like fathersheartbible.com/print), semi-transparent charcoal */
      .site-header.is-overlay { position: fixed; inset: 0 0 auto 0; background: var(--color-charcoal-glass); border-bottom-color: transparent; -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); transition: background-color 0.25s ease; padding-top: env(safe-area-inset-top, 0px); }
      .site-header.is-overlay.is-solid { background: var(--color-charcoal-solid); }
      .is-overlay .wordmark { color: var(--color-on-dark); }
      .is-overlay .nav-desktop a { color: var(--color-on-dark); }
      .is-overlay .nav-desktop a:hover, .is-overlay .nav-desktop a[aria-current='page'] { color: var(--color-on-dark); border-bottom-color: var(--color-gold); }
      .is-overlay .nav-mobile summary span { background: var(--color-on-dark); }
      .is-overlay .nav-mobile nav { background: var(--color-charcoal); border-color: var(--color-line-dark); }
      .is-overlay .nav-mobile nav a { color: var(--color-on-dark); }

      .site-footer { padding-block: 56px 28px; }
      .footer-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1fr); gap: 32px; }
      .footer-brand { display: grid; gap: 6px; align-content: start; }
      .footer-nav { display: grid; gap: 8px; align-content: start; }
      .footer-nav a, .footer-socials a, .footer-mail { color: var(--color-on-dark); text-decoration: none; }
      .footer-nav a:hover, .footer-socials a:hover, .footer-mail:hover { color: var(--color-gold); }
      .footer-contact { display: grid; gap: 8px; align-content: start; }
      .footer-socials { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 16px; }
      .footer-legal { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--color-line-dark); font-size: 13px; color: var(--color-on-dark-soft); }
      .footer-legal a { color: var(--color-on-dark); }
      @media (max-width: 720px) { .footer-grid { grid-template-columns: 1fr; } }
    </style>

    {overlayHeader && (
      <script is:inline>
        (function () {
          var h = document.getElementById('site-header');
          var hero = document.querySelector('[data-hero]');
          if (!h || !hero || !('IntersectionObserver' in window)) return;
          new IntersectionObserver(function (e) { h.classList.toggle('is-solid', !e[0].isIntersecting); }, { rootMargin: '-80px 0px 0px 0px' }).observe(hero);
        })();
      </script>
    )}

    <!-- Deferred third-party JS (Trait 5) — fill GA4 ID when the property is created.
    <script is:inline>
      const loadAnalytics = () => {
        if (window._smpAnalyticsLoaded) return;
        window._smpAnalyticsLoaded = true;
        const s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=GTM_ID';
        s.async = true;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){ window.dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'GTM_ID');
      };
      ['scroll', 'click', 'touchstart', 'keydown', 'mousemove'].forEach((e) =>
        window.addEventListener(e, loadAnalytics, { once: true, passive: true })
      );
      setTimeout(loadAnalytics, 8000);
    </script>
    -->
  </body>
</html>
