---
// Events — upcoming dates from Sanity, then a speaking request section.
import Layout from '../layouts/Layout.astro';
import MailtoLink from '../components/MailtoLink.astro';
import { sanityClient, urlFor } from '../lib/sanity';
import { getSettings } from '../lib/site';

const data = await sanityClient.fetch(`{
  "page": *[_type == "eventsPage"][0],
  "events": *[_type == "event" && date >= now()] | order(date asc){title, date, location, description, url, image}
}`);
const settings = await getSettings();
const { page, events } = data;
const fmt = (d: string) => new Date(d).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Layout title="Events | Kevin & Shelly White" description={page.intro}>
  <main id="main-content">
    <section class="band band-light">
      <div class="container-site stack">
        <p class="eyebrow">Events</p>
        <h1 class="type-hero">{page.heading}</h1>
        <p class="type-lead">{page.intro}</p>
        {events?.length > 0
          ? (
            <ul class="events">
              {events.map((e: any) => (
                <li class="event">
                  <p class="event-date">{fmt(e.date)}</p>
                  <div class="stack">
                    <h2 class="type-h3">{e.title}</h2>
                    {e.location && <p class="text-soft">{e.location}</p>}
                    {e.description && <p>{e.description}</p>}
                    {e.url && <a class="link" href={e.url} rel="noopener" target="_blank">Details</a>}
                  </div>
                  {e.image && <img class="rounded-photo" src={urlFor(e.image).width(480).height(320).format('webp').url()} width="480" height="320" loading="lazy" decoding="async" alt={e.image.alt ?? ''} />}
                </li>
              ))}
            </ul>
          )
          : <p class="empty">{page.emptyText}</p>}
      </div>
    </section>

    <section class="band band-dark" aria-labelledby="speaking-heading">
      <div class="container-site split split-top">
        <div class="stack">
          <p class="eyebrow">Speaking</p>
          <h2 id="speaking-heading" class="type-h2">{page.speakingHeading}</h2>
          <p class="type-lead">{page.speakingText}</p>
          <div class="btn-row">
            {settings?.kevinEmail && <MailtoLink email={settings.kevinEmail} class="btn btn-primary">Email Kevin</MailtoLink>}
            {settings?.shellyEmail && <MailtoLink email={settings.shellyEmail} class="btn btn-ghost">Email Shelly</MailtoLink>}
          </div>
        </div>
        <div id="ghl-speaking-form" class="form-placeholder">Speaking request form</div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .events { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 0; }
  .event { display: grid; grid-template-columns: minmax(0, 220px) minmax(0, 1fr) minmax(0, 240px); gap: 24px; padding-block: 28px; border-top: 1px solid var(--color-line-strong); align-items: start; }
  @media (max-width: 820px) { .event { grid-template-columns: 1fr; } }
  .event-date { font-weight: 700; color: var(--color-denim); }
  .empty { font-size: 18px; padding: 28px 0; border-top: 1px solid var(--color-line-strong); margin-top: 8px; }
  .band-dark .form-placeholder { border-color: var(--color-line-dark); color: var(--color-on-dark-soft); }
</style>
