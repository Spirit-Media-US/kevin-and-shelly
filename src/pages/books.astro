---
// Books (Kevin 2026-10-14): New from Shelly (Zacchaeus, large, with description) → Kevin's books →
// Father's Heart Bible section (the FHB homepage marquee + FATHER/SON/SPIRIT + back-cover copy +
// buttons + tagline, every FHB link going to the print page) → Spirit Media Publishing + FHB cards.
// Covers sit on charcoal bands; the FHB 3D covers sit on stone, as on fathersheartbible.com.
import CoverMarquee from '../components/CoverMarquee.astro';
import Layout from '../layouts/Layout.astro';
import { sanityClient, urlFor } from '../lib/sanity';

const data = await sanityClient.fetch(`{
  "page": *[_type == "booksPage"][0],
  "shelly": *[_type == "book" && section == "shelly"] | order(order asc){title, subtitle, author, cover, description, buyUrl, buyLabel},
  "kevin": *[_type == "book" && section == "kevin"] | order(order asc){title, author, cover, description, buyUrl, buyLabel},
  "ministries": *[_type == "ministry"] | order(order asc){name, summary, url, linkLabel}
}`);
const { page, shelly, kevin, ministries } = data;
const feature = shelly?.[0];
const cover = (b: any, w: number) => urlFor(b.cover).width(w).format('webp').quality(82).url();
const ratio = (b: any) => {
  const m = /-(\d+)x(\d+)-/.exec(b?.cover?.asset?._ref ?? '');
  return m ? Number(m[2]) / Number(m[1]) : 1.5;
};
const FHB_PRINT = 'https://fathersheartbible.com/print/';
const FHB_READ = 'https://fathersheartbible.com/read/';
---

<Layout title="Books | Kevin & Shelly White" description="Books by Shelly White and Kevin White, and the Father's Heart Bible in Divine Voice Color, published by Spirit Media Publishing. Available worldwide everywhere books are sold.">
  <Fragment slot="head">
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    {feature && <link rel="preload" as="image" href={cover(feature, 640)} imagesrcset={`${cover(feature, 420)} 420w, ${cover(feature, 640)} 640w`} imagesizes="(max-width: 820px) 80vw, 520px" fetchpriority="high" />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: [...(shelly ?? []), ...(kevin ?? [])].map((b: any, i: number) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Book', name: b.title, author: { '@type': 'Person', name: b.author }, url: b.buyUrl } })),
    })}></script>
  </Fragment>

  <main id="main-content">
    {feature && (
      <section class="band band-dark" aria-labelledby="new-heading">
        <div class="container-site new-book">
          <img class="book-cover new-cover" src={cover(feature, 640)} srcset={`${cover(feature, 420)} 420w, ${cover(feature, 640)} 640w`}
            sizes="(max-width: 820px) 80vw, 520px" width="640" height={Math.round(640 * ratio(feature))}
            alt={feature.cover?.alt ?? `${feature.title} cover`} fetchpriority="high" loading="eager" decoding="async" />
          <div class="stack">
            <p class="eyebrow">{page?.newLabel ?? 'New from Shelly'}</p>
            <h1 id="new-heading" class="type-hero">{feature.title}</h1>
            <p class="text-soft">by {feature.author}</p>
            <div class="prose-story type-lead">{(feature.description ?? '').split('\n\n').map((p: string) => <p>{p}</p>)}</div>
            {feature.buyUrl
              ? <div class="btn-row"><a class="btn btn-primary" href={feature.buyUrl} rel="noopener" target="_blank">{feature.buyLabel ?? 'Get the book'}</a></div>
              : <p class="eyebrow">{feature.buyLabel ?? 'Available worldwide everywhere books are sold'}</p>}
          </div>
        </div>
      </section>
    )}

    {kevin?.length > 0 && (
      <section class="band band-dark band-kevin" aria-labelledby="kevin-heading">
        <div class="container-site stack">
          <h2 id="kevin-heading" class="type-h2">{page?.kevinHeading ?? "Kevin's Books"}</h2>
          <ul class="books-list">
            {kevin.map((b: any) => (
              <li class="book-item">
                <img class="book-cover" src={cover(b, 360)} width="360" height={Math.round(360 * ratio(b))} loading="lazy" decoding="async" alt={b.cover?.alt ?? `${b.title} cover`} />
                <div class="stack">
                  <h3 class="type-h3">{b.title}</h3>
                  <p class="text-soft">{b.author}</p>
                  <p class="text-soft book-desc">{b.description}</p>
                  {b.buyUrl && <a class="link" href={b.buyUrl} rel="noopener" target="_blank">{b.buyLabel ?? 'Get the book'}</a>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- Father's Heart Bible — same marquee, chips and back-cover copy as fathersheartbible.com -->
    <section class="fhb-block" aria-label="Father's Heart Bible">
      <CoverMarquee />
      <div class="container-site fhb-copy">
        <p>For a hundred and twenty-five years, red letters have shown you the Son speaking. Our Father speaks more than three times as often — 128,579 words across 5,615 verses. Father's Heart Bible is the first Bible in print where you can see who is speaking.</p>
        <p>Our Father's words in <strong class="v-father">BLUE</strong>. The Son's in <strong class="v-son">RED</strong>. The Spirit's in <strong class="v-spirit">PURPLE</strong>.</p>
        <p>More than one word in four of the Bible is a divine voice speaking. This is not a study Bible about our Father. It is His voice, made visible, so you can hear it.</p>
        <div class="btn-row fhb-btns">
          <a class="btn btn-primary" href={FHB_PRINT}>Get It in Print</a>
          <a class="btn btn-ghost" href={FHB_READ}>Read &amp; Listen Free</a>
        </div>
        <p class="fhb-tagline">Receive the Father. Hear his voice. His heart is for you.</p>
      </div>
    </section>

    {ministries?.length > 0 && (
      <section class="band band-light-deep">
        <div class="container-site stack">
          <p class="eyebrow">Publisher</p>
          <h2 class="type-h2">{page?.publisherHeading ?? 'Published by Spirit Media Publishing'}</h2>
          <ul class="pub-list">
            {ministries.map((m: any) => (
              <li class="stack">
                <h3 class="type-h3">{m.name}</h3>
                <p class="text-soft">{m.summary}</p>
                {m.url && <a class="link" href={m.name === "Father's Heart Bible" ? FHB_PRINT : m.url} rel="noopener">{m.linkLabel ?? 'Visit'}</a>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </main>
</Layout>

<style>
  .new-book { display: grid; grid-template-columns: minmax(0, 520px) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .new-cover { max-width: 520px; }
  @media (max-width: 820px) { .new-book { grid-template-columns: 1fr; } .new-cover { max-width: 80vw; margin-inline: auto; } }
  .band-kevin { border-top: 1px solid var(--color-line-dark); }
  .books-list { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 460px), 1fr)); gap: 44px 48px; }
  .book-item { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 24px; align-items: start; }
  .book-desc { font-size: 15.5px; }
  @media (max-width: 480px) { .book-item { grid-template-columns: 110px minmax(0, 1fr); } }
  .fhb-block { background: var(--color-stone); }
  .fhb-copy { max-width: 820px; text-align: center; display: grid; gap: 16px; padding-block: 32px clamp(56px, 7vw, 88px); font-size: 19px; line-height: 1.65; color: var(--color-soft); }
  .fhb-btns { justify-content: center; margin-top: 16px; }
  .fhb-tagline { margin-top: 16px; font-size: clamp(17px, 2vw, 22px); color: var(--color-ink); text-wrap: balance; }
  .v-father { color: var(--color-voice-father); }
  .v-son { color: var(--color-voice-son); }
  .v-spirit { color: var(--color-voice-spirit); }
  .pub-list { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 32px; }
</style>
