---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found | Kevin and Shelly" noindex>
  <main id="main-content" class="band band-light">
    <div class="container-site stack">
      <p class="eyebrow">404</p>
      <h1 class="type-hero">This page isn't here.</h1>
      <p class="type-lead">The page may have moved. Start from the home page or listen to the podcast.</p>
      <div class="btn-row"><a class="btn btn-primary" href="/">Go home</a><a class="btn btn-ghost" href="/podcast">The podcast</a></div>
    </div>
  </main>
</Layout>
