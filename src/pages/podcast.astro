---
// Podcast — Revived by Our Father's Love. Show artwork + description on a dark band,
// listen links, then every episode ("New ___" big, subtitle small).
import Layout from '../layouts/Layout.astro';
import { sanityClient, urlFor } from '../lib/sanity';

const data = await sanityClient.fetch(`{
  "show": *[_type == "podcastShow"][0],
  "episodes": *[_type == "podcastEpisode"] | order(episodeNumber asc){word, subtitle, episodeNumber, releaseDate, description, thumbnail, youtubeId, audioUrl}
}`);
const { show, episodes } = data;
const art = (w: number) => urlFor(show.artwork).width(w).format('webp').quality(80).url();
const artSrcset = `${art(640)} 640w, ${art(1000)} 1000w`;
const paras = (show.description ?? '').split('\n\n');
---

<Layout title="Revived by Our Father's Love Podcast | Kevin and Shelly White" description={paras[0]}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link rel="preload" as="image" href={art(1000)} imagesrcset={artSrcset} imagesizes="(max-width: 820px) 100vw, 600px" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'PodcastSeries',
      name: show.title,
      description: paras[0],
      author: [{ '@type': 'Person', name: 'Kevin White' }, { '@type': 'Person', name: 'Shelly White' }],
      publisher: { '@type': 'Organization', name: 'Spirit Media Publishing' },
    })}></script>
  </Fragment>

  <main id="main-content">
    <section class="band band-dark">
      <div class="container-site split">
        <img class="show-art" src={art(1000)} srcset={artSrcset} sizes="(max-width: 820px) 100vw, 600px" width="1000" height="737"
          alt={show.artwork?.alt ?? show.title} fetchpriority="high" loading="eager" decoding="async" />
        <div class="stack">
          <p class="eyebrow">The podcast · {show.schedule}</p>
          <h1 class="type-hero">{show.title}</h1>
          <p class="type-lead">{show.tagline}</p>
          {show.listenLinks?.length > 0 && (
            <div class="btn-row">
              {show.listenLinks.map((l: any, i: number) => (
                <a class={`btn ${i === 0 ? 'btn-primary' : 'btn-ghost'}`} href={l.url} rel="noopener" target="_blank">{l.label}</a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    <section class="band band-light">
      <div class="container-site about-show">
        <h2 class="type-h2">About the show</h2>
        <div class="prose-story type-lead">{paras.map((p: string) => <p>{p}</p>)}</div>
      </div>
    </section>

    <section class="band band-dark" aria-labelledby="episodes-heading">
      <div class="container-site stack">
        <p class="eyebrow">Episodes</p>
        <h2 id="episodes-heading" class="type-h2">Season 1</h2>
        <ol class="episode-list">
          {episodes.map((ep: any) => (
            <li class="ep-row">
              <span class="ep-word">{ep.word}</span>
              <span>
                <span class="ep-sub">{ep.subtitle}</span>
                <span class="text-soft ep-meta">{ep.releaseDate ? `Episode ${ep.episodeNumber} · ${ep.releaseDate}` : `Episode ${ep.episodeNumber} · Coming soon`}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>
</Layout>

<style>
  .show-art { width: 100%; height: auto; border-radius: var(--radius); }
  .about-show { display: grid; gap: 18px; max-width: 820px; }
  .episode-list { list-style: none; margin: 8px 0 0; padding: 0; }
  .ep-sub { display: block; }
  .ep-meta { display: block; font-size: 13.5px; margin-top: 2px; }
</style>
