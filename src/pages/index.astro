---
// Home — hero (us) → podcast (dark) → story preview (light) → Shelly's new book (dark) → blog (light) → sign-up.
// Events removed until needed (Kevin 2026-10-15).
// Hero keeps the 100 Club pattern: srcset with a ≤640w entry, head preload with fetchpriority,
// explicit width/height, no animation on the first section (Traits 1, 2, 7, 8).
import Layout from '../layouts/Layout.astro';
import { sanityClient, urlFor } from '../lib/sanity';
import { EPISODE_FIELDS, EPISODE_FILTER, episodeThumb } from '../lib/site';

const data = await sanityClient.fetch(`{
  "home": *[_type == "homePage"][0],
  "show": *[_type == "podcastShow"][0]{title, tagline, schedule, description, artwork},
  "episodes": *[${EPISODE_FILTER}] | order(episodeNumber desc)[0...4]{${EPISODE_FIELDS}},
  "feature": *[_type == "book" && section == "shelly"] | order(order asc)[0]{title, author, cover, description, buyUrl, buyLabel},
  "posts": *[_type == "blogPost"] | order(publishDate desc)[0...3]{title, excerpt, heroImage, publishDate, "slug": slug.current}
}`);
const { home, show, feature, posts } = data;
// The latest four episodes, shown in episode order.
const episodes = [...(data.episodes ?? [])].reverse();
const featureRatio = (() => { const m = /-(\d+)x(\d+)-/.exec(feature?.cover?.asset?._ref ?? ''); return m ? Number(m[2]) / Number(m[1]) : 1; })();
const featureCover = (w: number) => urlFor(feature.cover).width(w).format('webp').quality(82).url();

const heroSrc = (w: number) => urlFor(home.heroImage).width(w).format('webp').quality(80).url();
// Hero is shown uncropped (Kevin 2026-10-14: the word BELOVED must show). Native width 1527px,
// so the largest srcset entry stops there and the image centers on wider screens.
const heroSrcset = `${heroSrc(640)} 640w, ${heroSrc(1200)} 1200w, ${heroSrc(1527)} 1527w`;
const heroSizes = '(max-width: 1527px) 100vw, 1527px';
const showIntro = (show?.description ?? '').split('\n\n')[0];
const fmt = (d: string) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Layout title="Kevin and Shelly White | Revived by Our Father's Love" overlayHeader>
  <Fragment slot="head">
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link rel="preload" as="image" href={heroSrc(1200)} imagesrcset={heroSrcset} imagesizes={heroSizes} fetchpriority="high" />
  </Fragment>

  <main id="main-content">
    <!-- HERO — first section: no animation hooks (Trait 7) -->
    <section class="hero" aria-labelledby="hero-heading">
      <img
        class="hero-img"
        data-hero
        src={heroSrc(1200)}
        srcset={heroSrcset}
        sizes={heroSizes}
        width="1527"
        height="1020"
        alt={home.heroImage?.alt ?? 'Kevin and Shelly White'}
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
      <div class="container-site hero-text">
        <h1 id="hero-heading" class="type-hero">{home.heading}</h1>
        <p class="type-lead">{home.intro}</p>
        <div class="btn-row">
          {home.primaryCtaLabel && <a class="btn btn-primary" href={home.primaryCtaUrl}>{home.primaryCtaLabel}</a>}
          {home.secondaryCtaLabel && <a class="btn btn-ghost" href={home.secondaryCtaUrl}>{home.secondaryCtaLabel}</a>}
        </div>
      </div>
    </section>

    <!-- PODCAST -->
    {show && (
      <section class="band band-dark" aria-labelledby="podcast-heading">
        <div class="container-site split">
          {show.artwork && (
            <a href="/podcast" class="art-link">
              <img
                src={urlFor(show.artwork).width(900).format('webp').quality(80).url()}
                srcset={`${urlFor(show.artwork).width(600).format('webp').quality(80).url()} 600w, ${urlFor(show.artwork).width(900).format('webp').quality(80).url()} 900w`}
                sizes="(max-width: 820px) 100vw, 560px"
                width="900" height="663" loading="lazy" decoding="async"
                alt={show.artwork.alt ?? show.title}
              />
            </a>
          )}
          <div class="stack">
            <p class="eyebrow">The podcast · {show.schedule}</p>
            <h2 id="podcast-heading" class="type-h2">{show.title}</h2>
            <p class="type-lead">{showIntro}</p>
            {episodes.length > 0 && (
              <ul class="home-eps">
                {episodes.map((ep: any) => {
                  const t = episodeThumb(ep);
                  return (
                    <li><a href={`/podcast/${ep.slug}/`} class="home-ep">
                      {t && <img src={t.src} srcset={t.srcset} sizes="(max-width: 820px) 50vw, 280px" width="1280" height="720" loading="lazy" decoding="async" alt={ep.thumbnail?.alt ?? ep.title} />}
                      <span class="home-ep-title">{ep.title}</span>
                    </a></li>
                  );
                })}
              </ul>
            )}
            <div class="btn-row"><a class="btn btn-primary" href="/podcast">Listen to Revived</a></div>
          </div>
        </div>
      </section>
    )}

    <!-- STORY PREVIEW -->
    <section class="band band-light" aria-labelledby="story-heading">
      <div class="container-site split split-reverse">
        <div class="stack">
          <p class="eyebrow">Our story</p>
          <h2 id="story-heading" class="type-h2">{home.storyHeading}</h2>
          <p class="type-lead">{home.storyText}</p>
          <div class="btn-row"><a class="btn btn-ghost" href="/story">Read our story</a></div>
        </div>
        {home.storyImage && (
          <img
            class="rounded-photo"
            src={urlFor(home.storyImage).width(900).height(640).format('webp').quality(80).url()}
            srcset={`${urlFor(home.storyImage).width(600).height(427).format('webp').quality(80).url()} 600w, ${urlFor(home.storyImage).width(900).height(640).format('webp').quality(80).url()} 900w`}
            sizes="(max-width: 820px) 100vw, 560px"
            width="900" height="640" loading="lazy" decoding="async"
            alt={home.storyImage.alt ?? 'Kevin and Shelly White'}
          />
        )}
      </div>
    </section>

    <!-- BOOKS — Shelly's new book featured, then a link to all books (Kevin 2026-10-15) -->
    {feature && (
      <section class="band band-dark" aria-labelledby="books-heading">
        <div class="container-site split">
          <a href="/books" class="feature-cover">
            <img class="book-cover" src={featureCover(640)} srcset={`${featureCover(420)} 420w, ${featureCover(640)} 640w`}
              sizes="(max-width: 820px) 80vw, 420px" width="640" height={Math.round(640 * featureRatio)}
              loading="lazy" decoding="async" alt={feature.cover?.alt ?? `${feature.title} cover`} />
          </a>
          <div class="stack">
            <p class="eyebrow">Books</p>
            <h2 id="books-heading" class="type-h2">{home.booksHeading ?? 'New from Shelly'}</h2>
            <h3 class="type-h3">{feature.title}</h3>
            <p class="type-lead">{(feature.description ?? '').split('\n\n').slice(0, 3).join(' ')}</p>
            {feature.buyUrl
              ? <div class="btn-row"><a class="btn btn-primary" href={feature.buyUrl} rel="noopener" target="_blank">{feature.buyLabel ?? 'Get the book'}</a><a class="btn btn-ghost" href="/books">See all our books</a></div>
              : <><p class="feature-avail">{feature.buyLabel ?? 'Available worldwide everywhere books are sold'}</p><div class="btn-row"><a class="btn btn-primary" href="/books">See all our books</a></div></>}
          </div>
        </div>
      </section>
    )}

    <!-- BLOG -->
    {posts?.length > 0 && (
      <section class="band band-light" aria-labelledby="blog-heading">
        <div class="container-site stack">
          <p class="eyebrow">From the blog</p>
          <h2 id="blog-heading" class="type-h2">Latest posts</h2>
          <ul class="post-grid">
            {posts.map((p: any) => (
              <li>
                <a href={`/blog/${p.slug}`} class="post-card">
                  {p.heroImage && <img src={urlFor(p.heroImage).width(640).height(400).format('webp').quality(78).url()} width="640" height="400" loading="lazy" decoding="async" alt={p.heroImage.alt ?? ''} />}
                  <span class="text-soft post-date">{fmt(p.publishDate)}</span>
                  <span class="post-title">{p.title}</span>
                  {p.excerpt && <span class="text-soft">{p.excerpt}</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- SIGN-UP -->
    <section class="band band-light-deep" aria-labelledby="signup-heading">
      <div class="container-site split split-top">
        <div class="stack">
          <h2 id="signup-heading" class="type-h2">{home.newsletterHeading}</h2>
          <p class="type-lead">{home.newsletterText}</p>
        </div>
        <div class="signup">
          <div id="ghl-signup-form" class="form-placeholder">Sign-up form</div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
.hero { background: var(--color-stone); }
  .hero-img { width: 100%; max-width: 1527px; height: auto; aspect-ratio: 1527 / 1020; margin-inline: auto; }
  .feature-cover { display: block; max-width: 420px; width: 100%; justify-self: center; }
  .feature-avail { font-weight: 700; color: var(--color-gold); }
  .home-eps { list-style: none; margin: 4px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 16px; }
  .home-ep { display: grid; gap: 8px; text-decoration: none; color: inherit; }
  .home-ep img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); }
  .home-ep-title { font-size: 14.5px; font-weight: 700; line-height: 1.3; }
  .home-ep:hover .home-ep-title { color: var(--color-gold); }
  .hero-text { display: grid; gap: 18px; padding-block: clamp(28px, 4vw, 48px) clamp(48px, 6vw, 72px); }
</style>
